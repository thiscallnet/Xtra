<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference android:key="customize_controls" android:summary="@string/settings_customize_controls_summary" android:title="@string/settings_customize_controls" app:iconSpaceReserved="false" />
    <ListPreference android:defaultValue="auto" android:entries="@array/playerControlScaleEntries" android:entryValues="@array/playerControlScaleValues" android:key="player_control_scale_portrait" android:summary="%s" android:title="@string/settings_player_control_scale_portrait" app:iconSpaceReserved="false" />
    <ListPreference android:defaultValue="100" android:entries="@array/playerControlScaleEntries" android:entryValues="@array/playerControlScaleValues" android:key="player_control_scale_landscape" android:summary="%s" android:title="@string/settings_player_control_scale_landscape" app:iconSpaceReserved="false" />
    <ListPreference android:defaultValue="above" android:entries="@array/playerControlPositionEntries" android:entryValues="@array/playerControlPositionValues" android:key="player_control_position" android:summary="%s" android:title="@string/settings_player_control_position" app:iconSpaceReserved="false" />
    <Preference android:key="clip_settings" android:summary="@string/settings_clip_capture_summary" android:title="@string/settings_clip_capture" app:iconSpaceReserved="false" />
    <Preference android:key="player_speed_options" android:summary="@string/settings_playback_speed_options_summary" android:title="@string/settings_playback_speed_options" app:iconSpaceReserved="false" />
    <Preference android:key="player_seek_controls" android:title="@string/settings_seek_controls" app:iconSpaceReserved="false" />
    <Preference android:key="player_gestures" android:title="@string/settings_gestures" app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat android:defaultValue="true" android:key="player_move_freely" android:summary="@string/settings_free_position_player_summary" android:title="@string/settings_free_position_player" app:iconSpaceReserved="false" />
    <Preference android:key="player_information" android:title="@string/settings_player_information" app:iconSpaceReserved="false" />
</androidx.preference.PreferenceScreen>
