<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/settings_section_app"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="app_language_page"
        android:summary="@string/settings_item_language_summary"
        android:title="@string/settings_language"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="app_updates_page"
        android:summary="@string/settings_home_updates_summary"
        android:title="@string/settings_general_updates"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="app_backup_page"
        android:summary="@string/settings_item_backup_summary"
        android:title="@string/settings_backup_restore"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="app_help_about_page"
        android:summary="@string/settings_help_about_summary"
        android:title="@string/settings_help_about"
        app:iconSpaceReserved="false" />
</androidx.preference.PreferenceScreen>
