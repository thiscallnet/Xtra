<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="?attr/dialogPadding">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/userLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/dialogPadding"
            android:paddingLeft="?attr/dialogPadding"
            android:paddingEnd="?attr/dialogPadding"
            android:paddingRight="?attr/dialogPadding"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/messageLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/userImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/open_channel"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                tools:src="@tools:sample/backgrounds/scenic"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/userIdentity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:minHeight="56dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/userImage"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:visibility="gone"
                    tools:text="@sample/games.json/top/game/name"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/userLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="@sample/games.json/top/game/name"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/userCreated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="Created at 123456"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/userFollowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="Followed at 123456"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/userSubscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone"
                    tools:text="Subscribed for 2 months"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/badgesHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userIdentity"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/badgesTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/user_card_badges"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/viewAllBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    tools:text="View all (24)"
                    tools:visibility="visible" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/badgesRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/badgesHeader"
                tools:itemCount="8"
                tools:listitem="@layout/item_user_card_badge"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/userActionRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/badgesRecyclerView">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/giftSubButton"
                    style="?attr/bottomSheetButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/user_card_gift_sub"
                    android:textAllCaps="false"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/followButton"
                    style="?attr/bottomSheetButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/user_card_follow"
                    android:textAllCaps="false"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/whisperButton"
                    style="?attr/bottomSheetButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/user_card_whisper"
                    android:textAllCaps="false"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/messageLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            android:paddingStart="?attr/dialogPadding"
            android:paddingLeft="?attr/dialogPadding"
            android:paddingEnd="?attr/dialogPadding"
            android:paddingRight="?attr/dialogPadding"
            app:layout_constraintBottom_toTopOf="@id/buttonLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/userLayout">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                tools:listitem="@layout/chat_list_item" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            android:paddingStart="?attr/dialogPadding"
            android:paddingLeft="?attr/dialogPadding"
            android:paddingEnd="?attr/dialogPadding"
            android:paddingRight="?attr/dialogPadding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/messageLayout">

            <Button
                android:id="@+id/reply"
                style="?attr/bottomSheetButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reply"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/copyMessage"
                style="?attr/bottomSheetButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_message"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/copyClip"
                style="?attr/bottomSheetButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_clip" />

            <Button
                android:id="@+id/copyFullMsg"
                style="?attr/bottomSheetButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_fullmsg"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/translateMessage"
                style="?attr/bottomSheetButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/translate_message"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/translateMessageSelectLanguage"
                style="?attr/bottomSheetButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/translate_from_selected"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/viewProfile"
                style="?attr/bottomSheetButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_profile"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
