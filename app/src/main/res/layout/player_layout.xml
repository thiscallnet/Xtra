<?xml version="1.0" encoding="utf-8"?>
<com.github.andreyasadchy.xtra.ui.player.hud.PlayerHudLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:visibility="gone"
    tools:alpha="1"
    tools:visibility="visible">

    <com.github.andreyasadchy.xtra.ui.player.hud.HudScrimView
        android:id="@+id/hudScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="STREAM_INFO">
        <LinearLayout
            android:id="@+id/topLeftLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/channelAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="visible" />
            <LinearLayout
                android:id="@+id/infoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/channel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical|start"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="channel"
                    tools:visibility="visible" />
                <LinearLayout
                    android:id="@+id/titleAndViewersLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="start"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_vertical|start"
                        android:maxLines="2"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeStepGranularity="1sp"
                        tools:text="A sample stream title"
                        tools:visibility="visible" />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/streamDetailsLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/playingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:importantForAccessibility="no"
                            android:text="@string/player_playing"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/category"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:visibility="visible" />
                        <TextView
                            android:id="@+id/category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="4dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/viewersLayout"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/playingLabel"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Just Chatting"
                            tools:visibility="visible" />
                        <LinearLayout
                            android:id="@+id/viewersLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center_vertical|start"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/category"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:visibility="visible">
                            <TextView
                                android:id="@+id/viewersText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@android:color/white"
                                tools:text="for 12,345 viewers" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>

    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="TIMELINE">
        <com.github.andreyasadchy.xtra.ui.player.hud.HudTimelineContent
            android:id="@+id/timelineContent"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:id="@+id/position"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:visibility="gone"
                tools:text="12:16" />
            <LinearLayout
                android:id="@+id/bottomLayout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical">
                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/progressBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:bar_height="4dp"
                    app:buffered_color="#66FFFFFF"
                    app:played_color="#FFB388FF"
                    app:scrubber_color="#FFB388FF"
                    app:scrubber_enabled_size="14dp"
                    app:unplayed_color="#66FFFFFF" />
                <Button
                    android:id="@+id/liveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_live"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/player_live"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/duration"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:visibility="gone"
                tools:text="1:12:16" />
        </com.github.andreyasadchy.xtra.ui.player.hud.HudTimelineContent>
    </com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>

    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="SEEK_BACK">
        <Button
            android:id="@+id/rewind"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/player_rewind"
            android:foreground="@drawable/exo_styled_controls_rewind"
            android:gravity="center|bottom"
            android:insetBottom="0dp"
            android:paddingBottom="12dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:tint="@android:color/white"
            tools:text="10" />
    </com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="PLAY_PAUSE">
        <ImageButton
            android:id="@+id/playPause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/player_play"
            android:src="@drawable/baseline_play_arrow_black_48"
            app:tint="@android:color/white" />
    </com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="SEEK_FORWARD">
        <Button
            android:id="@+id/fastForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/player_fast_forward"
            android:foreground="@drawable/exo_styled_controls_fastforward"
            android:gravity="center|bottom"
            android:insetBottom="0dp"
            android:paddingBottom="12dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:tint="@android:color/white"
            tools:text="10" />
    </com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>

    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="FOLLOW"><ImageButton android:id="@+id/follow" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_follow" android:src="@drawable/baseline_favorite_border_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="QUALITY">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/quality"
            android:layout_width="88dp"
            android:layout_height="36dp"
            android:ellipsize="end"
            android:contentDescription="@string/player_quality"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textAllCaps="false"
            android:text="@string/auto"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/chatStatusDark"
            app:cornerRadius="8dp"
            app:icon="@drawable/baseline_settings_black_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white" />
    </com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="ASPECT_RATIO"><ImageButton android:id="@+id/aspectRatio" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_aspect_ratio" android:src="@drawable/baseline_aspect_ratio_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="VOLUME"><ImageButton android:id="@+id/volume" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_volume" android:src="@drawable/baseline_volume_up_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="CLIP"><ImageButton android:id="@+id/clip" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_clip" android:src="@drawable/ic_movie_clip_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="CHAT"><ImageButton android:id="@+id/toggleChat" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_show_chat" android:src="@drawable/baseline_speaker_notes_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="FULLSCREEN"><ImageButton android:id="@+id/fullscreen" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_enter_fullscreen" android:src="@drawable/baseline_fullscreen_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="MORE"><ImageButton android:id="@+id/menu" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_more_options" android:src="@drawable/baseline_more_vert_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>

    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="INTERACTION_LOCK"><ImageButton android:id="@+id/interactionLock" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_lock_controls" android:src="@drawable/baseline_lock_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="MINIMIZE"><ImageButton android:id="@+id/minimize" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_minimize" android:src="@drawable/baseline_expand_more_black_48" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="DOWNLOAD"><ImageButton android:id="@+id/download" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_download" android:src="@drawable/ic_file_download_black_24dp" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="SPEED"><ImageButton android:id="@+id/speed" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_playback_speed" android:src="@drawable/exo_ic_speed" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="CHAPTERS"><ImageButton android:id="@+id/vodGames" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_vod_games" android:src="@drawable/baseline_format_list_bulleted_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="RESTART"><ImageButton android:id="@+id/restart" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_restart" android:src="@drawable/baseline_replay_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="GO_LIVE"><ImageButton android:id="@+id/seekLive" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_seek_live" android:src="@drawable/exo_icon_fastforward" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="AUDIO_MODE"><ImageButton android:id="@+id/audioOnly" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_audio_only" android:src="@drawable/baseline_audiotrack_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="AUDIO_COMPRESSOR"><ImageButton android:id="@+id/audioCompressor" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_audio_compressor" android:src="@drawable/baseline_audio_compressor_off_24dp" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="CHAT_INPUT"><ImageButton android:id="@+id/toggleChatInput" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_chat_input" android:src="@drawable/baseline_keyboard_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="SLEEP_TIMER"><ImageButton android:id="@+id/sleepTimer" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_sleep_timer" android:src="@drawable/baseline_alarm_black_24" app:tint="@android:color/white" /></com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
    <com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame android:tag="CAPTIONS">
        <FrameLayout
            android:id="@+id/captionsContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton android:id="@+id/liveCaptions" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_live_captions" android:src="@drawable/exo_ic_subtitle_off" android:visibility="gone" app:tint="@android:color/white" />
            <ImageButton android:id="@+id/subtitles" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/player_subtitles" android:src="@drawable/exo_ic_subtitle_off" android:visibility="gone" app:tint="@android:color/white" />
        </FrameLayout>
    </com.github.andreyasadchy.xtra.ui.player.hud.HudElementFrame>
</com.github.andreyasadchy.xtra.ui.player.hud.PlayerHudLayout>
