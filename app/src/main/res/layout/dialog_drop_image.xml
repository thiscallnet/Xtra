<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.github.andreyasadchy.xtra.ui.drops.ZoomableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/drops_view_image"
        android:saveEnabled="true"
        android:scaleType="matrix" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="4dp"
        app:navigationContentDescription="@string/drops_close_image"
        app:navigationIcon="@drawable/baseline_close_black_36"
        app:navigationIconTint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/zoomHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/drops_zoom_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

</FrameLayout>
