<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/slidingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.github.andreyasadchy.xtra.ui.view.PlayerLayout
            android:id="@+id/playerLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/black">

            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/aspectRatioFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <SurfaceView
                    android:id="@+id/playerSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </androidx.media3.ui.AspectRatioFrameLayout>

            <androidx.media3.ui.SubtitleView
                android:id="@+id/subtitleView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/bufferingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

            <View
                android:id="@+id/dragView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/playerControls"
                layout="@layout/player_layout" />

            <FrameLayout
                android:id="@+id/miniPlayerChrome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/miniPlayerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="96dp"
                    android:layout_marginBottom="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    tools:text="channel · stream title" />

                <ImageButton
                    android:id="@+id/miniPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_play"
                    android:src="@drawable/baseline_play_arrow_black_48"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/miniExpand"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_miniplayer_expand"
                    android:src="@drawable/baseline_expand_more_black_24"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/miniClose"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|end"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/player_miniplayer_close"
                    android:src="@drawable/baseline_close_black_36"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    app:tint="@android:color/white" />

            </FrameLayout>

            <TextView
                android:id="@+id/seekFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@color/chatStatusDark"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="+10s"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/temporarySpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@color/chatStatusDark"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/player_temporary_speed"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/playerErrorContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                android:focusable="true"
                android:importantForAccessibility="yes"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardUseCompatPadding="true"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/playerErrorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxWidth="320dp"
                        android:text="@string/player_error"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playerErrorRetry"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/retry" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </com.github.andreyasadchy.xtra.ui.view.PlayerLayout>

        <com.github.andreyasadchy.xtra.ui.view.ChatLayout
            android:id="@+id/chatLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?android:colorBackground">

            <LinearLayout
                android:id="@+id/chatLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/chatFragmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/watchVideo"
                    style="?attr/elevatedButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:text="@string/watch_video"
                    android:textAllCaps="true"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:id="@+id/chatTouchView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.github.andreyasadchy.xtra.ui.view.ChatLayout>

    </FrameLayout>

</FrameLayout>
