<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/rootTopFragment">

    <fragment
        android:id="@+id/rootGamesFragment"
        android:name="com.github.andreyasadchy.xtra.ui.browse.BrowsePagerFragment"
        android:label="@string/browse">
    </fragment>
    <fragment
        android:id="@+id/rootDiscoverFragment"
        android:name="com.github.andreyasadchy.xtra.ui.discover.DiscoverFragment"
        android:label="@string/discover">
    </fragment>
    <fragment
        android:id="@+id/rootTopFragment"
        android:name="com.github.andreyasadchy.xtra.ui.overview.OverviewFragment"
        android:label="@string/following_overview">
    </fragment>
    <fragment
        android:id="@+id/gamesFragment"
        android:name="com.github.andreyasadchy.xtra.ui.games.GamesFragment"
        android:label="@string/following_categories">
        <argument
            android:name="tags"
            app:argType="com.github.andreyasadchy.xtra.model.ui.Tag[]"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <action
        android:id="@+id/action_global_gamesFragment"
        app:destination="@id/gamesFragment" />
    <fragment
        android:id="@+id/topFragment"
        android:name="com.github.andreyasadchy.xtra.ui.top.TopStreamsFragment"
        android:label="@string/popular">
        <argument
            android:name="tags"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="languages"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <action
        android:id="@+id/action_global_topFragment"
        app:destination="@id/topFragment" />
    <fragment
        android:id="@+id/followPagerFragment"
        android:name="com.github.andreyasadchy.xtra.ui.following.FollowPagerFragment"
        android:label="@string/following">
        <argument
            android:name="initialTabKey"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/followMediaFragment"
        android:name="com.github.andreyasadchy.xtra.ui.following.FollowMediaFragment"
        android:label="@string/following" />
    <fragment
        android:id="@+id/savedPagerFragment"
        android:name="com.github.andreyasadchy.xtra.ui.saved.SavedPagerFragment"
        android:label="@string/saved" />
    <fragment
        android:id="@+id/savedMediaFragment"
        android:name="com.github.andreyasadchy.xtra.ui.saved.SavedMediaFragment"
        android:label="@string/saved" />
    <fragment
        android:id="@+id/searchPagerFragment"
        android:name="com.github.andreyasadchy.xtra.ui.search.SearchPagerFragment" />
    <action
        android:id="@+id/action_global_searchPagerFragment"
        app:destination="@id/searchPagerFragment" />
    <fragment
        android:id="@+id/gamePagerFragment"
        android:name="com.github.andreyasadchy.xtra.ui.game.GamePagerFragment">
        <argument
            android:name="gameId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="gameSlug"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="gameName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="boxArt"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="tags"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="languages"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="updateLocal"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>
    <action
        android:id="@+id/action_global_gamePagerFragment"
        app:destination="@id/gamePagerFragment" />
    <fragment
        android:id="@+id/gameMediaFragment"
        android:name="com.github.andreyasadchy.xtra.ui.game.GameMediaFragment">
        <argument
            android:name="gameId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="gameSlug"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="gameName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="boxArt"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="tags"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="languages"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="updateLocal"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>
    <action
        android:id="@+id/action_global_gameMediaFragment"
        app:destination="@id/gameMediaFragment" />
    <fragment
        android:id="@+id/channelPagerFragment"
        android:name="com.github.andreyasadchy.xtra.ui.channel.ChannelPagerFragment">
        <argument
            android:name="channelId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="channelLogin"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="channelName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="channelImage"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="updateLocal"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="streamId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <action
        android:id="@+id/action_global_channelPagerFragment"
        app:destination="@id/channelPagerFragment" />
    <fragment
        android:id="@+id/teamFragment"
        android:name="com.github.andreyasadchy.xtra.ui.team.TeamFragment">
        <argument
            android:name="teamName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <action
        android:id="@+id/action_global_teamFragment"
        app:destination="@id/teamFragment" />

    <fragment
        android:id="@+id/multiviewFragment"
        android:name="com.github.andreyasadchy.xtra.ui.multiview.MultiviewFragment" />
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.github.andreyasadchy.xtra.ui.statistics.StatisticsFragment"
        android:label="@string/statistics" />
    <action
        android:id="@+id/action_global_statisticsFragment"
        app:destination="@id/statisticsFragment" />
    <fragment
        android:id="@+id/statisticsDetailFragment"
        android:name="com.github.andreyasadchy.xtra.ui.statistics.StatisticsDetailFragment"
        android:label="@string/statistics" />
    <fragment
        android:id="@+id/statisticsListFragment"
        android:name="com.github.andreyasadchy.xtra.ui.statistics.StatisticsListFragment"
        android:label="@string/statistics" />
    <fragment
        android:id="@+id/twitchNotificationsFragment"
        android:name="com.github.andreyasadchy.xtra.ui.notifications.TwitchNotificationsFragment"
        android:label="@string/notifications" />
    <action
        android:id="@+id/action_global_twitchNotificationsFragment"
        app:destination="@id/twitchNotificationsFragment" />
    <fragment
        android:id="@+id/dropsFragment"
        android:name="com.github.andreyasadchy.xtra.ui.drops.DropsFragment"
        android:label="@string/drops">
        <argument
            android:name="campaignId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <action
        android:id="@+id/action_global_dropsFragment"
        app:destination="@id/dropsFragment" />
    <fragment
        android:id="@+id/whispersFragment"
        android:name="com.github.andreyasadchy.xtra.ui.whispers.WhispersFragment"
        android:label="@string/whispers" />
    <action
        android:id="@+id/action_global_whispersFragment"
        app:destination="@id/whispersFragment" />
    <fragment
        android:id="@+id/whisperThreadFragment"
        android:name="com.github.andreyasadchy.xtra.ui.whispers.WhisperThreadFragment"
        android:label="@string/whispers">
        <argument
            android:name="peerId"
            app:argType="string" />
        <argument
            android:name="peerLogin"
            app:argType="string" />
        <argument
            android:name="peerDisplayName"
            app:argType="string" />
        <argument
            android:name="peerImageUrl"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="threadId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
</navigation>
