# This file is sourced by Mozilla's configure machinery. Keep options limited
# to flags verified against the pinned Gecko revision in SOURCE_REVISION.

ac_add_options --enable-project=mobile/android
ac_add_options --enable-geckoview-lite
ac_add_options --disable-debug
ac_add_options --enable-optimize
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
# Keep printing enabled for the control baseline; pinned Gecko 150 Android
# still registers its print-settings component when printing is disabled.
ac_add_options --disable-backgroundtasks
ac_add_options --disable-pref-extensions
ac_add_options --with-ccache=sccache

# Telemetry reporting is not part of an Xtra authentication engine build.
unset MOZ_TELEMETRY_REPORTING

mk_add_options AUTOCLOBBER=1
